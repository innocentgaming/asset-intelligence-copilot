# Asset Intelligence Copilot Configuration
# Hacktoberfest 2026 Hack Day Pune · FlytBase Challenge

# LLM Preset: 'aistudio', 'openrouter', or 'ollama'
COPILOT_PRESET=aistudio

# API Keys (Do NOT commit real keys to git)
# For Google AI Studio (Free): https://aistudio.google.com/
COPILOT_API_KEY=AIzaSy_YOUR_GEMMA_API_KEY_HERE

# For OpenRouter: https://openrouter.ai/
# COPILOT_PRESET=openrouter
# COPILOT_API_KEY=sk-or-v1-YOUR_OPENROUTER_KEY_HERE
# COPILOT_MODEL=google/gemma-4-31b-it

# For Local Ollama:
# COPILOT_PRESET=ollama
# COPILOT_MODEL=gemma4
# COPILOT_BASE_URL=http://localhost:11434/v1

# Server & Dataset Paths
COPILOT_PORT=8501
DATASET_PATH=dataset/sample-data
TEST_DATASET_PATH=
